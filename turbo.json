{
      "$schema": "https://turborepo.dev/schema.json",
      "ui": "tui",
      "globalDependencies": [".env"],
      "globalEnv": ["DATABASE_URL", "REDIS_URL", "NODE_ENV"],
      "tasks": {
            "build": {
                  "dependsOn": ["^build"],
                  "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.test.ts", ".env*"],
                  "outputs": [".next/**", "!.next/cache/**", "dist/**", "generated/**"]
            },
            "lint": {
                  "dependsOn": ["^topo"]
            },
            "check-types": {
                  "dependsOn": ["^build"]
            },
            "dev": {
                  "cache": false,
                  "persistent": true,
                  "dependsOn": ["^build"]
            },

            "test": { "dependsOn": ["^build"], "inputs": ["$TURBO_DEFAULT$", "jest.config.*"], "outputs": ["coverage/**"] },
            "test:coverage": {
                  "dependsOn": ["^build"],
                  "inputs": ["$TURBO_DEFAULT$", "jest.config.*"],
                  "outputs": ["coverage/**"]
            },
            "topo": {
                  "dependsOn": ["^topo"]
            }
      }
}
