{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["**/.env.*local"],
    "globalEnv": ["NODE_ENV"],
    "tasks": {
      "build": {
        "dependsOn": ["^build"],
        "outputs": ["dist/**", ".next/**", "build/**", ".expo/**"]
      },
      "dev": {
        "cache": false,
        "persistent": true
      },
      "lint": {
      },
      "type-check": {
        "dependsOn": ["^build"],
        "outputs": []
      },
      "format": {
        "cache": false,
        "outputs": []
    },
      "test": {
        "dependsOn": ["^build"],
        "outputs": ["coverage/**"]
      },
      "clean": {
        "cache": false
      }
    }
  }