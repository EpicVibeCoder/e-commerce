{
  "name": "e-commerce-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:docker": "docker-compose -f docker-compose.dev.yml up",
    "dev:docker:build": "docker-compose -f docker-compose.dev.yml up --build",
    "dev:docker:down": "docker-compose -f docker-compose.dev.yml down",
    "dev:docker:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "dev:infra": "docker-compose -f docker-compose.infrastructure.yml up -d",
    "dev:infra:down": "docker-compose -f docker-compose.infrastructure.yml down",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "dev:backend": "turbo run dev --filter=backend",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "check-updates": "npx npm-check-updates",
    "update-deps": "npx npm-check-updates -u"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.7.2"
  },
  "overrides": {
    "inflight": "npm:@isaacs/inflight@^1.0.6",
    "glob": "^10.3.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.7.0"
}