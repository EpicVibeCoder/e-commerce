{
      "name": "e-commerce",
      "private": true,
      "scripts": {
            "build": "turbo run build",
            "dev": "turbo run dev",
            "lint": "turbo run lint",
            "check-types": "turbo run check-types",
            "db:generate": "dotenv -e .env -- npm run db:generate --workspace=packages/database",
            "db:migrate": "dotenv -e .env -- npm run db:migrate --workspace=packages/database",
            "db:seed": "dotenv -e .env -- npm run db:seed --workspace=packages/database",
            "db:studio": "dotenv -e .env -- npx prisma studio --config packages/database/prisma.config.ts",
            "test": "turbo run test",
            "test:coverage": "turbo run test:coverage",
            "format": "prettier --write .",
            "format:check": "prettier --check ."
      },
      "devDependencies": {
            "dotenv-cli": "^11.0.0",
            "prettier": "3.8.1",
            "turbo": "^2.8.9",
            "typescript": "^5.9.3"
      },
      "engines": {
            "node": ">=24"
      },
      "packageManager": "npm@11.10.0",
      "workspaces": [
            "apps/*",
            "packages/*"
      ],
      "dependencies": {
            "@types/node": "^25.3.0",
            "@types/pg": "^8.16.0",
            "@types/jest": "^29.5.14",
            "jest": "^30.2.0",
            "ts-jest": "^29.2.5",
            "prisma": "^7.4.0"
      }
      
}
