{
      "name": "e-commerce",
      "private": true,
      "scripts": {
            "env:check": "dotenv -e .env -- tsx scripts/check-env.ts",
            "dev": "npm run env:check && dotenv -e .env -- turbo run dev",
            "lint": "turbo run lint --filter=!mobile",
            "build": "npm run env:check && dotenv -e .env -- turbo run build --filter=!mobile",
            "check-types": "turbo run check-types --filter=!mobile",
            "db:generate": "dotenv -e .env -- npm run db:generate --workspace=packages/database",
            "db:migrate": "dotenv -e .env -- npm run db:migrate --workspace=packages/database",
            "db:seed": "dotenv -e .env -- npm run db:seed --workspace=packages/database",
            "db:studio": "dotenv -e .env -- npx prisma studio --config packages/database/prisma.config.ts --port 5555",
            "test": "dotenv -e .env -- turbo run test",
            "test:coverage": "turbo run test:coverage",
            "format": "prettier --write .",
            "format:check": "prettier --check .",
            "validate": "npm run format:check && npm run lint && npm run check-types && npm run test && npm run build"
      },
      "devDependencies": {
            "dotenv-cli": "^11.0.0",
            "prettier": "3.8.3",
            "turbo": "^2.9.14",
            "typescript": "^6.0.3",
            "eslint": "^10.4.0",
            "@types/node": "^25.9.1",
            "@types/pg": "^8.20.0",
            "@types/jest": "^30.0.0",
            "jest": "^30.4.2",
            "ts-jest": "^29.4.11",
            "prisma": "^7.8.0"
      },
      "engines": {
            "node": ">=24"
      },
      "packageManager": "npm@11.10.0",
      "workspaces": [
            "apps/*",
            "packages/*"
      ],
      "dependencies": {}
}
