{
      "name": "e-commerce-root",
      "private": true,
      "workspaces": [
            "apps/*"
      ],
      "packageManager": "npm@11.12.1",
      "scripts": {
            "dev:api": "dotenv -e .env -- npm run start:dev --prefix apps/api",
            "dev:admin": "dotenv -e .env -- npm run dev --prefix apps/admin",
            "dev:storefront": "dotenv -e .env -- npm run dev --prefix apps/storefront",
            "dev": "dotenv -e .env -- turbo run dev start:dev",
            "build": "turbo run build",
            "lint:api": "npm run lint:ci --prefix apps/api",
            "lint:admin": "npm run lint --prefix apps/admin",
            "lint:storefront": "npm run lint --prefix apps/storefront",
            "lint": "npm run lint:api && npm run lint:admin && npm run lint:storefront",
            "check-types:api": "npm run check-types --prefix apps/api",
            "check-types:admin": "npm run check-types --prefix apps/admin",
            "check-types:storefront": "npm run check-types --prefix apps/storefront",
            "check-types": "npm run check-types:api && npm run check-types:admin && npm run check-types:storefront",
            "test": "turbo run test",
            "db:generate": "dotenv -e .env -- npm run db:generate --prefix apps/api",
            "db:migrate": "dotenv -e .env -- npm run db:migrate --prefix apps/api",
            "db:migrate:deploy": "dotenv -e .env -- npm run db:migrate:deploy --prefix apps/api",
            "db:seed": "dotenv -e .env -- npm run db:seed --prefix apps/api",
            "db:studio": "dotenv -e .env -- npm run db:studio --prefix apps/api",
            "db:reset": "dotenv -e .env -- npm run db:reset --prefix apps/api",
            "install:root": "npm install",
            "install:api": "npm install --prefix apps/api",
            "install:admin": "npm install --prefix apps/admin",
            "install:storefront": "npm install --prefix apps/storefront",
            "install:apps": "npm run install:api && npm run install:admin && npm run install:storefront",
            "install:all": "npm run install:root && npm run install:apps",
            "format": "prettier --write ."
      },
      "devDependencies": {
            "dotenv-cli": "^11.0.0",
            "prettier": "^3.8.4",
            "turbo": "^2.9.18"
      }
}
