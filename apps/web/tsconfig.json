{
      "extends": "../../tsconfig.json",
      "compilerOptions": {
            "target": "ES2017",
            "lib": ["dom", "dom.iterable", "esnext"],
            "noEmit": true,
            "jsx": "react-jsx",
            "plugins": [
                  {
                        "name": "next"
                  }
            ],
            "paths": {
                  "@/*": ["./*"]
            }
      },
      "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "**/*.mts"],
      "exclude": ["node_modules"]
}
