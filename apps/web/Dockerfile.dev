FROM node:22-alpine

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

# Copy package files and install as root (no permission issues)
COPY package*.json ./
RUN npm install

# Copy source code with proper ownership
COPY --chown=node:node . .

# Ensure all files including node_modules are owned by node user
RUN chown -R node:node /app

# Switch to node user for runtime
USER node

EXPOSE 3000

CMD ["npm", "run", "dev"]