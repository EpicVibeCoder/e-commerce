{
      "name": "api",
      "version": "0.0.1",
      "description": "",
      "author": "",
      "private": true,
      "license": "UNLICENSED",
      "scripts": {
            "build": "nest build",
            "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
            "start": "nest start",
            "start:dev": "nest start --watch",
            "start:debug": "nest start --debug --watch",
            "start:prod": "node dist/main",
            "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
            "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\"",
            "check-types": "tsc -p tsconfig.build.json --noEmit",
            "db:generate": "prisma generate --config prisma.config.ts",
            "db:migrate": "prisma migrate dev --config prisma.config.ts",
            "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
            "db:seed": "prisma db seed --config prisma.config.ts",
            "db:studio": "prisma studio --config prisma.config.ts",
            "db:reset": "prisma migrate reset --config prisma.config.ts",
            "test": "vitest run",
            "test:watch": "vitest --watch",
            "test:cov": "vitest --coverage",
            "test:debug": "vitest --inspect-brk --pool forks --poolOptions.forks.singleFork",
            "test:e2e": "vitest run --config test/vitest.config.ts test"
      },
      "dependencies": {
            "@apollo/server": "^5.5.1",
            "@as-integrations/express5": "^1.1.2",
            "@nestjs/apollo": "^14.0.2",
            "@nestjs/common": "^12.1.0",
            "@nestjs/config": "^12.0.1",
            "@nestjs/core": "^12.1.0",
            "@nestjs/graphql": "^14.0.2",
            "@nestjs/jwt": "^11.0.2",
            "@nestjs/passport": "^11.0.5",
            "@nestjs/platform-express": "^12.1.0",
            "@nestjs/swagger": "^12.0.2",
            "@prisma/adapter-pg": "^7.10.0",
            "@prisma/client": "^7.10.0",
            "bcrypt": "^6.0.0",
            "class-transformer": "^0.5.1",
            "class-validator": "^0.15.1",
            "dotenv": "^17.4.2",
            "graphql": "^16.14.2",
            "ioredis": "^5.11.1",
            "passport": "^0.7.0",
            "passport-jwt": "^4.0.1",
            "pg": "^8.21.0",
            "reflect-metadata": "^0.2.2",
            "rxjs": "^7.8.1",
            "swagger-ui-express": "^5.0.1"
      },
      "devDependencies": {
            "@eslint/eslintrc": "^3.2.0",
            "@eslint/js": "^9.18.0",
            "@nestjs/cli": "^12.0.0",
            "@nestjs/schematics": "^12.0.0",
            "@nestjs/testing": "^12.0.3",
            "@swc/core": "^1.16.2",
            "@types/bcrypt": "^6.0.0",
            "@types/express": "^5.0.0",
            "@types/node": "^24.0.0",
            "@types/passport-jwt": "^4.0.1",
            "@types/supertest": "^7.0.0",
            "eslint": "^9.18.0",
            "eslint-config-prettier": "^10.0.1",
            "eslint-plugin-prettier": "^5.5.6",
            "globals": "^17.0.0",
            "prisma": "^7.8.0",
            "source-map-support": "^0.5.21",
            "supertest": "^7.0.0",
            "ts-loader": "^9.5.2",
            "ts-node": "^10.9.2",
            "tsconfig-paths": "^4.2.0",
            "tsx": "^4.22.4",
            "typescript": "^6.0.3",
            "typescript-eslint": "^8.20.0",
            "unplugin-swc": "^1.6.0",
            "vite-tsconfig-paths": "^6.1.1",
            "vitest": "^5.0.1"
      }
}
