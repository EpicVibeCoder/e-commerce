# ============================================
# Application Configuration
# ============================================
# Environment: development | production | test
NODE_ENV=development
# Application port
PORT=3000

# Application URL (for payment callbacks)
# For production: Set to your actual backend URL, e.g., https://api.yourdomain.com
APP_URL=http://localhost:3000

# ============================================
# Database Configuration
# ============================================
# Database connection URL 
# For production: Use your managed database connection string
# Format: mysql://user:password@host:port/database?query_params
DATABASE_URL=place_your_db_url_here

# Database connection details (used by Docker Compose and DATABASE_URL construction)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mini_ecommerce
DB_USER=ecommerce_user
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
DB_ROOT_PASSWORD=CHANGE_THIS_TO_SECURE_ROOT_PASSWORD
# Configure the MySQL connection flags based on your hosting environment. 
#For local MySQL or Docker setups without SSL, set DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true and DB_SSL=false. 
#For managed or cloud databases (like AWS RDS, Google Cloud SQL, etc.), set DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false and DB_SSL=true. 
#If you encounter an error saying "RSA public key is not available," it means you are using MySQL 8 locally, and you should enable DB_ALLOW_PUBLIC_KEY_RETRIEVAL and disable SSL.
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true
DB_SSL=false

# ============================================
# Redis Configuration
# ============================================
# For production: Use your managed Redis service host
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: Redis password if using AUTH
# REDIS_PASSWORD=your_redis_password_here

# ============================================
# Security & Authentication
# ============================================
# JWT Secret Key (REQUIRED: Minimum 32 characters)
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_MINIMUM_32_CHARACTERS_SECRET_KEY
JWT_EXPIRES_IN=24h

# CORS Configuration
# For production: Set to your frontend domain(s), e.g., https://yourdomain.com
# Multiple origins: http://localhost:3000,https://app.example.com
CORS_ORIGIN=http://localhost:3000

# ============================================
# Payment Gateway Configuration
# ============================================
# Stripe (Required for Stripe payments)
# Get from: https://dashboard.stripe.com/apikeys
# Test keys start with: sk_test_ and pk_test_
# Live keys start with: sk_live_ and pk_live_
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# bKash (Required for bKash payments)
# Get from: https://developer.bka.sh/ or https://pgw-integration.bkash.com/
# Register as a merchant to obtain credentials
# Sandbox credentials for testing, Production credentials for live payments
BKASH_APP_KEY=your_bkash_app_key_here
BKASH_APP_SECRET=your_bkash_app_secret_here
BKASH_USERNAME=your_bkash_username_here
BKASH_PASSWORD=your_bkash_password_here
# bKash API Base URL
# Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Production: https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Set to 'true' for sandbox/testing, 'false' for production
BKASH_IS_SANDBOX=true

# ============================================
# Production Deployment Notes
# ============================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with your actual credentials
# 3. Generate secure passwords and secrets:
#    - JWT_SECRET: openssl rand -base64 32
#    - DB_PASSWORD: Use a strong password generator
#    - DB_ROOT_PASSWORD: Use a strong password generator
# 4. For production:
#    - Use managed database (AWS RDS, Google Cloud SQL, etc.)
#    - Use managed Redis (AWS ElastiCache, Redis Cloud, etc.)
#    - Set NODE_ENV=production
#    - Use strong JWT_SECRET (generate with: openssl rand -base64 32)
#    - Set CORS_ORIGIN to your actual frontend domain
#    - Set APP_URL to your production backend URL (e.g., https://api.yourdomain.com)
#    - Enable SSL/TLS for database connections (DB_SSL=true)
#    - Update BKASH_BASE_URL to production URL: https://tokenized.pay.bka.sh/v1.2.0-beta
#    - Set BKASH_IS_SANDBOX=false for production
#    - Use production Stripe keys (sk_live_...)
#    - Use production bKash credentials
# 5. Never commit .env to version control
# 6. Keep .env.example updated with all required variables