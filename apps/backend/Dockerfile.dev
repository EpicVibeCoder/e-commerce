FROM node:22-alpine

WORKDIR /app

# Install dependencies first (better layer caching)
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

EXPOSE 3000

# Wait for MySQL, then run migrations (database is already created by MySQL container)
CMD sh -c "echo '🔧 Generating Prisma Client...' && npx prisma generate && echo '⏳ Waiting for MySQL to be ready...' && sleep 20 && echo '🔄 Running Prisma migrations...' && npx prisma migrate deploy && echo '🚀 Starting dev server...' && npm run start:dev"