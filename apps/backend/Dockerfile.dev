# ./apps/backend/Dockerfile.dev
FROM node:22-alpine

# Create app directory
WORKDIR /app

# Install dependencies first (better layer caching)
COPY package*.json ./
RUN npm install

# Copy source code
# Note: 'compose watch' will overwrite this with local files dev,
# but this copy is needed for the initial image build.
COPY . .

# Expose the port
EXPOSE 3000

# Start command
CMD ["npm", "run", "dev"]