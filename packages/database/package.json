{
      "name": "@repo/database",
      "private": true,
      "type": "module",
      "scripts": {
            "db:generate": "prisma generate",
            "db:migrate": "prisma migrate dev",
            "db:seed": "tsx prisma/seed.ts",
            "build": "dotenv -e ../../.env -- prisma generate && tsc",
            "test": "jest",
            "test:coverage": "jest --coverage",
            "lint": "eslint . --max-warnings 0",
            "check-types": "tsc --noEmit"
      },
      "dependencies": {
            "@prisma/adapter-pg": "^7.4.0",
            "@prisma/client": "^7.4.0",
            "@repo/jest-config": "*",
            "bcrypt": "^6.0.0",
            "dotenv": "^17.3.1",
            "pg": "^8.18.0"
      },
      "devDependencies": {
            "@mermaid-js/mermaid-cli": "^11.12.0",
            "@types/bcrypt": "^6.0.0",
            "prisma": "^7.4.0",
            "tsx": "^4.22.3",
            "prisma-erd-generator": "^2.4.3",
            "puppeteer": "^23.11.1",
            "@repo/eslint-config": "*"
      },
      "main": "dist/generated/prisma/client.js",
      "types": "dist/generated/prisma/client.d.ts",
      "exports": {
            ".": {
                  "types": "./dist/generated/prisma/client.d.ts",
                  "import": "./dist/generated/prisma/client.js",
                  "require": "./dist/generated/prisma/client.js"
            },
            "./enums": {
                  "types": "./dist/generated/prisma/enums.d.ts",
                  "import": "./dist/generated/prisma/enums.js",
                  "require": "./dist/generated/prisma/enums.js"
            }
      }
}
