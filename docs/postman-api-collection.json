{
      "info": {
            "name": "E-commerce API",
            "description": "Collection to test the NestJS API locally.",
            "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "variable": [
            {
                  "key": "baseUrl",
                  "value": "http://localhost:3000"
            },
            {
                  "key": "registerEmail",
                  "value": ""
            },
            {
                  "key": "accessToken",
                  "value": ""
            }
      ],
      "item": [
            {
                  "name": "Root",
                  "event": [
                        {
                              "listen": "test",
                              "script": {
                                    "exec": [
                                          "pm.test(\"Status code is 200\", function () {",
                                          "    pm.response.to.have.status(200);",
                                          "});",
                                          "pm.test(\"Response is 'Hello World!'\", function () {",
                                          "    pm.response.to.have.text(\"Hello World!\");",
                                          "});"
                                    ],
                                    "type": "text/javascript"
                              }
                        }
                  ],
                  "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                              "raw": "{{baseUrl}}/api/v1",
                              "host": ["{{baseUrl}}"],
                              "path": ["api", "v1"]
                        },
                        "description": "GET root – returns Hello World"
                  }
            },
            {
                  "name": "Auth",
                  "item": [
                        {
                              "name": "Register Successful",
                              "event": [
                                    {
                                          "listen": "prerequest",
                                          "script": {
                                                "exec": ["const randomSuffix = Math.floor(Math.random() * 1000000);", "const randomEmail = `user_${randomSuffix}@example.com`;", "pm.collectionVariables.set(\"registerEmail\", randomEmail);"],
                                                "type": "text/javascript"
                                          }
                                    },
                                    {
                                          "listen": "test",
                                          "script": {
                                                "exec": [
                                                      "pm.test(\"Status code is 201\", function () {",
                                                      "    pm.response.to.have.status(201);",
                                                      "});",
                                                      "pm.test(\"Response contains accessToken and user details\", function () {",
                                                      "    var jsonData = pm.response.json();",
                                                      "    pm.expect(jsonData).to.have.property(\"accessToken\");",
                                                      "    pm.expect(jsonData).to.have.property(\"user\");",
                                                      "    pm.expect(jsonData.user).to.have.property(\"id\");",
                                                      "    pm.expect(jsonData.user).to.have.property(\"email\");",
                                                      "    pm.expect(jsonData.user.email).to.eql(pm.collectionVariables.get(\"registerEmail\"));",
                                                      "    pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
                                                      "});"
                                                ],
                                                "type": "text/javascript"
                                          }
                                    }
                              ],
                              "request": {
                                    "method": "POST",
                                    "header": [
                                          {
                                                "key": "Content-Type",
                                                "value": "application/json",
                                                "type": "text"
                                          }
                                    ],
                                    "body": {
                                          "mode": "raw",
                                          "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"Password123!\",\n  \"name\": \"Test User\"\n}"
                                    },
                                    "url": {
                                          "raw": "{{baseUrl}}/api/v1/auth/register",
                                          "host": ["{{baseUrl}}"],
                                          "path": ["api", "v1", "auth", "register"]
                                    },
                                    "description": "Registers a new user with a dynamically generated random email."
                              }
                        },
                        {
                              "name": "Register Error - Duplicate Email",
                              "event": [
                                    {
                                          "listen": "test",
                                          "script": {
                                                "exec": [
                                                      "pm.test(\"Status code is 409\", function () {",
                                                      "    pm.response.to.have.status(409);",
                                                      "});",
                                                      "pm.test(\"Error message is 'Email already registered'\", function () {",
                                                      "    var jsonData = pm.response.json();",
                                                      "    pm.expect(jsonData.message).to.eql(\"Email already registered\");",
                                                      "    pm.expect(jsonData.error).to.eql(\"Conflict\");",
                                                      "});"
                                                ],
                                                "type": "text/javascript"
                                          }
                                    }
                              ],
                              "request": {
                                    "method": "POST",
                                    "header": [
                                          {
                                                "key": "Content-Type",
                                                "value": "application/json",
                                                "type": "text"
                                          }
                                    ],
                                    "body": {
                                          "mode": "raw",
                                          "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"Password123!\",\n  \"name\": \"Duplicate User\"\n}"
                                    },
                                    "url": {
                                          "raw": "{{baseUrl}}/api/v1/auth/register",
                                          "host": ["{{baseUrl}}"],
                                          "path": ["api", "v1", "auth", "register"]
                                    },
                                    "description": "Attempts to register a user with an already registered email, expecting a 409 Conflict error."
                              }
                        },
                        {
                              "name": "Register Error - Invalid Email Format",
                              "event": [
                                    {
                                          "listen": "test",
                                          "script": {
                                                "exec": [
                                                      "pm.test(\"Status code is 400\", function () {",
                                                      "    pm.response.to.have.status(400);",
                                                      "});",
                                                      "pm.test(\"Validation error states email must be an email\", function () {",
                                                      "    var jsonData = pm.response.json();",
                                                      "    pm.expect(jsonData.message).to.be.an(\"array\");",
                                                      "    pm.expect(jsonData.message).to.include(\"email must be an email\");",
                                                      "});"
                                                ],
                                                "type": "text/javascript"
                                          }
                                    }
                              ],
                              "request": {
                                    "method": "POST",
                                    "header": [
                                          {
                                                "key": "Content-Type",
                                                "value": "application/json",
                                                "type": "text"
                                          }
                                    ],
                                    "body": {
                                          "mode": "raw",
                                          "raw": "{\n  \"email\": \"invalid-email-format\",\n  \"password\": \"Password123!\",\n  \"name\": \"Bad Email User\"\n}"
                                    },
                                    "url": {
                                          "raw": "{{baseUrl}}/api/v1/auth/register",
                                          "host": ["{{baseUrl}}"],
                                          "path": ["api", "v1", "auth", "register"]
                                    },
                                    "description": "Attempts to register with an invalid email format, expecting a 400 Bad Request error."
                              }
                        },
                        {
                              "name": "Register Error - Weak Password",
                              "event": [
                                    {
                                          "listen": "test",
                                          "script": {
                                                "exec": [
                                                      "pm.test(\"Status code is 400\", function () {",
                                                      "    pm.response.to.have.status(400);",
                                                      "});",
                                                      "pm.test(\"Validation error states password length requirements\", function () {",
                                                      "    var jsonData = pm.response.json();",
                                                      "    pm.expect(jsonData.message).to.be.an(\"array\");",
                                                      "    pm.expect(jsonData.message).to.include(\"password must be longer than or equal to 8 characters\");",
                                                      "});"
                                                ],
                                                "type": "text/javascript"
                                          }
                                    }
                              ],
                              "request": {
                                    "method": "POST",
                                    "header": [
                                          {
                                                "key": "Content-Type",
                                                "value": "application/json",
                                                "type": "text"
                                          }
                                    ],
                                    "body": {
                                          "mode": "raw",
                                          "raw": "{\n  \"email\": \"weakpwd@example.com\",\n  \"password\": \"123\",\n  \"name\": \"Weak Pwd User\"\n}"
                                    },
                                    "url": {
                                          "raw": "{{baseUrl}}/api/v1/auth/register",
                                          "host": ["{{baseUrl}}"],
                                          "path": ["api", "v1", "auth", "register"]
                                    },
                                    "description": "Attempts to register with a password shorter than 8 characters, expecting a 400 Bad Request error."
                              }
                        },
                        {
                              "name": "Login Successful",
                              "event": [
                                    {
                                          "listen": "test",
                                          "script": {
                                                "exec": [
                                                      "pm.test(\"Status code is 201\", function () {",
                                                      "    pm.response.to.have.status(201);",
                                                      "});",
                                                      "pm.test(\"Response contains accessToken and user details\", function () {",
                                                      "    var jsonData = pm.response.json();",
                                                      "    pm.expect(jsonData).to.have.property(\"accessToken\");",
                                                      "    pm.expect(jsonData).to.have.property(\"user\");",
                                                      "    pm.expect(jsonData.user.email).to.eql(pm.collectionVariables.get(\"registerEmail\"));",
                                                      "    pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
                                                      "});"
                                                ],
                                                "type": "text/javascript"
                                          }
                                    }
                              ],
                              "request": {
                                    "method": "POST",
                                    "header": [
                                          {
                                                "key": "Content-Type",
                                                "value": "application/json",
                                                "type": "text"
                                          }
                                    ],
                                    "body": {
                                          "mode": "raw",
                                          "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"Password123!\"\n}"
                                    },
                                    "url": {
                                          "raw": "{{baseUrl}}/api/v1/auth/login",
                                          "host": ["{{baseUrl}}"],
                                          "path": ["api", "v1", "auth", "login"]
                                    },
                                    "description": "Logs in the user registered in the first step using saved credentials."
                              }
                        },
                        {
                              "name": "Login Error - Invalid Password",
                              "event": [
                                    {
                                          "listen": "test",
                                          "script": {
                                                "exec": [
                                                      "pm.test(\"Status code is 401\", function () {",
                                                      "    pm.response.to.have.status(401);",
                                                      "});",
                                                      "pm.test(\"Error message is 'Invalid credentials'\", function () {",
                                                      "    var jsonData = pm.response.json();",
                                                      "    pm.expect(jsonData.message).to.eql(\"Invalid credentials\");",
                                                      "    pm.expect(jsonData.error).to.eql(\"Unauthorized\");",
                                                      "});"
                                                ],
                                                "type": "text/javascript"
                                          }
                                    }
                              ],
                              "request": {
                                    "method": "POST",
                                    "header": [
                                          {
                                                "key": "Content-Type",
                                                "value": "application/json",
                                                "type": "text"
                                          }
                                    ],
                                    "body": {
                                          "mode": "raw",
                                          "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"WrongPassword!\"\n}"
                                    },
                                    "url": {
                                          "raw": "{{baseUrl}}/api/v1/auth/login",
                                          "host": ["{{baseUrl}}"],
                                          "path": ["api", "v1", "auth", "login"]
                                    },
                                    "description": "Attempts to login with a correct email but incorrect password, expecting a 401 Unauthorized error."
                              }
                        },
                        {
                              "name": "Login Error - Non-existent User",
                              "event": [
                                    {
                                          "listen": "test",
                                          "script": {
                                                "exec": [
                                                      "pm.test(\"Status code is 401\", function () {",
                                                      "    pm.response.to.have.status(401);",
                                                      "});",
                                                      "pm.test(\"Error message is 'Invalid credentials'\", function () {",
                                                      "    var jsonData = pm.response.json();",
                                                      "    pm.expect(jsonData.message).to.eql(\"Invalid credentials\");",
                                                      "    pm.expect(jsonData.error).to.eql(\"Unauthorized\");",
                                                      "});"
                                                ],
                                                "type": "text/javascript"
                                          }
                                    }
                              ],
                              "request": {
                                    "method": "POST",
                                    "header": [
                                          {
                                                "key": "Content-Type",
                                                "value": "application/json",
                                                "type": "text"
                                          }
                                    ],
                                    "body": {
                                          "mode": "raw",
                                          "raw": "{\n  \"email\": \"doesnotexist_xyz@example.com\",\n  \"password\": \"Password123!\"\n}"
                                    },
                                    "url": {
                                          "raw": "{{baseUrl}}/api/v1/auth/login",
                                          "host": ["{{baseUrl}}"],
                                          "path": ["api", "v1", "auth", "login"]
                                    },
                                    "description": "Attempts to login with an email that is not registered, expecting a 401 Unauthorized error."
                              }
                        },
                        {
                              "name": "Login Error - Invalid Email Format",
                              "event": [
                                    {
                                          "listen": "test",
                                          "script": {
                                                "exec": [
                                                      "pm.test(\"Status code is 400\", function () {",
                                                      "    pm.response.to.have.status(400);",
                                                      "});",
                                                      "pm.test(\"Validation error states email must be an email\", function () {",
                                                      "    var jsonData = pm.response.json();",
                                                      "    pm.expect(jsonData.message).to.be.an(\"array\");",
                                                      "    pm.expect(jsonData.message).to.include(\"email must be an email\");",
                                                      "});"
                                                ],
                                                "type": "text/javascript"
                                          }
                                    }
                              ],
                              "request": {
                                    "method": "POST",
                                    "header": [
                                          {
                                                "key": "Content-Type",
                                                "value": "application/json",
                                                "type": "text"
                                          }
                                    ],
                                    "body": {
                                          "mode": "raw",
                                          "raw": "{\n  \"email\": \"invalidemail\",\n  \"password\": \"Password123!\"\n}"
                                    },
                                    "url": {
                                          "raw": "{{baseUrl}}/api/v1/auth/login",
                                          "host": ["{{baseUrl}}"],
                                          "path": ["api", "v1", "auth", "login"]
                                    },
                                    "description": "Attempts to login with an invalid email format, expecting a 400 Bad Request error."
                              }
                        }
                  ]
            }
      ]
}
